{
  "mcpServers": {
    "agent-core-busproxy": {
      "command": "uvx",
      "args": [
        "agent-core-busproxy",
        "--agent",
        "{{ endpoint_name }}",
        "--daemon-url",
        "http://127.0.0.1:8789"
      ]
    },
    "agent-core-channel": {
      "command": "uvx",
      "args": [
        "agent-core-channel",
        "--agent",
        "{{ endpoint_name }}",
        "--daemon-url",
        "http://127.0.0.1:8788"
      ]
    }
  }
}
