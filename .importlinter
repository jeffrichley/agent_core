[importlinter]
root_packages =
    agent_core

[importlinter:contract:bus-core-self-contained]
name = bus core does not depend on other agent_core subpackages
type = forbidden
source_modules =
    agent_core.bus
forbidden_modules =
    agent_core.cli
    agent_core.email
    agent_core.notify
    agent_core.endpoints
    agent_core.bus_hooks
    agent_core.skills
