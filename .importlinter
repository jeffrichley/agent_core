[importlinter]
root_packages =
    agent_core
    agent_core_notify
    agent_core_credentials

[importlinter:contract:bus-core-self-contained]
name = bus core does not depend on other agent-core packages
type = forbidden
source_modules =
    agent_core.bus
forbidden_modules =
    agent_core.cli
    agent_core.email
    agent_core.endpoints
    agent_core.bus_hooks
    agent_core.skills
    agent_core_notify
